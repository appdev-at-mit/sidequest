{
  "name": "sidequest",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,cyan \"npm run dev -w apps/server\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "eslint apps",
    "format": "prettier --write apps docs README.md",
    "db:seed": "npm run db:seed -w apps/server",
    "db:reset": "npm run db:reset -w apps/server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "prettier": "^3.6.2",
    "@eslint/js": "^9.39.0",
    "vite": "^7.3.0"
  },
  "overrides": {
    "tinypool": "^2.1.2",
    "vite": "$vite"
  }
}