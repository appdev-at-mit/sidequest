# Backend runtime only. Never prefix private values with VITE_.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/sidequest?replicaSet=sidequest
MONGODB_DB_NAME=sidequest
SESSION_SECRET=replace-with-at-least-32-random-characters

# Exact public frontend origin. Used for write-origin checks in production.
APP_BASE_URL=http://localhost:5174

# Optional: configure one for the scheduled GitHub Actions background job.
BACKGROUND_JOB_SECRET=replace-with-a-separate-random-secret

# Optional application settings
ADMIN_KERBS=
MODERATOR_KERBS=
MAX_QUEST_REWARD_CENTS=100000
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
MAX_IMAGE_PIXELS=16777216
MAX_CONCURRENT_IMAGE_UPLOADS=3
MAX_USER_IMAGE_STORAGE_BYTES=104857600
MAX_GLOBAL_IMAGE_STORAGE_BYTES=5368709120
PHOTON_API_URL=https://photon.komoot.io/api/
